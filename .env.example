# Django Settings
# Copy this file to .env and update with your actual values

# SECURITY WARNING: keep the secret key used in production secret!
# Generate a new secret key with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-secret-key-here-generate-a-new-one

# SECURITY WARNING: don't run with debug turned on in production!
# Set to False in production
DEBUG=True

# Comma-separated list of allowed hosts
# Production example: ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,192.168.1.100
# Development: ALLOWED_HOSTS=localhost,127.0.0.1
# Agribank Gia Rai internal network: 10.135.7.108
ALLOWED_HOSTS=localhost,127.0.0.1,10.135.7.108

# Database (Optional - defaults to SQLite)
# DATABASE_URL=sqlite:///db.sqlite3

# Static files (Optional)
# STATIC_ROOT=/path/to/staticfiles
# MEDIA_ROOT=/path/to/media
